{
  "name": "@hfalconer/pi-history",
  "version": "0.4.0",
  "description": "Persistent cross-session prompt history for Pi.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/henriquefalconer/pi-history.git"
  },
  "bugs": {
    "url": "https://github.com/henriquefalconer/pi-history/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build:test": "tsc --ignoreConfig src/history.ts src/scan.ts --types node --outDir dist-test --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck",
    "test": "npm run build:test && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^6.0.3"
  }
}
